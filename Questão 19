#include <stdio.h>

int main() {
//declaração de variáveis 
float largura, comprimento, area;

//processamento 
printf("Digite a largura do lote: ");
scanf("%f", &largura);

printf("Digite o comprimento do lote: ");
scanf("%f", &comprimento);

area = largura * comprimento;

//saída 
printf("A area total do lote e: %.2f m²\n", area);

return 0;
}
