#include <stdio.h>

int main() {

//declaração de variaveis 
float valor, desconto, novoValor;

//processamento 
printf("Digite o valor do produto: ");
scanf("%f", &valor);

desconto = valor * 0.09;
novoValor = valor - desconto;

//saida
printf("Valor do desconto: R$ %.2f\n", desconto);
printf("Novo valor do produto: R$ %.2f\n", novoValor);

return 0;
}
