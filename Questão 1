#include <stdio.h>
int main (){

//declaração de variáveis
int numero1, numero2, soma;

//processamento
printf("Inserir primeiro numero : ");
scanf("%d", &numero1);
printf("Inserir segundo número: ");
scanf("%d", &numero2); 

soma = numero1 + numero2;

//saída
printf("A soma é:%d\n", &soma);

return 0;
}
