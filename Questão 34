#include <stdio.h>

int main() {

//declaração de variáveis 
float peso, altura, imc;

//processamento 
printf("Digite o peso em kg: ");
scanf("%f", &peso);

printf("Digite a altura em metros: ");
scanf("%f", &altura);

imc = peso / (altura * altura);

//saída 
printf("O seu IMC é: %.2f\n", imc);

return 0;
}
