#include <stdio.h>
#include <math.h>

int main() {

//declaração de variáveis 
float custo, preco;
float custoComLucro;
int quantidadeCusto, quantidadeLucro;

//processamento 
printf("Digite o custo do espetaculo: ");
scanf("%f", &custo);

printf("Digite o preco do convite: ");
scanf("%f", &preco);

quantidadeCusto = ceil(custo / preco);

custoComLucro = custo + (custo * 0.23);
quantidadeLucro = ceil(custoComLucro / preco);

//saída 
printf("Convites para alcancar o custo: %d\n", quantidadeCusto);
printf("Convites para obter 23%% de lucro: %d\n", quantidadeLucro);

return 0;

}
