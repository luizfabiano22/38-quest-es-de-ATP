#include <stdio.h>

int main() {

//declaração de variáveis 
int valor1, valor2, valor3;
int soma;
float media;

//processamento 
printf("Digite o primeiro valor: ");
scanf("%d", &valor1);

printf("Digite o segundo valor: ");
scanf("%d", &valor2);

printf("Digite o terceiro valor: ");
scanf("%d", &valor3);

soma = valor1 + valor2 + valor3;
media = soma / 3.0;


//saida
printf("\nSomatorio = %d", soma);
printf("\nMedia = %.2f", media);

printf("\nResto de %d %% %d = %d", soma, valor1, soma % valor1);
printf("\nResto de %d %% %d = %d", soma, valor2, soma % valor2);
printf("\nResto de %d %% %d = %d\n", soma, valor3, soma % valor3);

return 0;

}
